# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
# Leave blank or set to 'memory' to use the zero-configuration embedded In-Memory MongoDB.
# Or provide your local/Atlas URI: mongodb://127.0.0.1:27017/campusconnect
MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect

# JWT Authentication Secrets
JWT_SECRET=campusconnect_super_secure_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=7d
